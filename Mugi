        BackgroundColor3 = Theme.Accent(),
        BorderSizePixel  = 0,
        Size             = DPI:U2(0,3,1,0),
    },card)
    Corner(3,accentBar)
    Gradient(Theme.Grad(),90,accentBar)

    New("TextLabel",{
        Font=Enum.Font.GothamBold,
        Text=Title,
        TextColor3=Theme.TextPri,
        TextSize=DPI:F(13),
        TextXAlignment=Enum.TextXAlignment.Left,
        BackgroundTransparency=1,
        BorderSizePixel=0,
        Position=DPI:U2(0,14,0,8),
        Size=DPI:U2(1,-60,0,15),
    },card)

    New("TextLabel",{
        Font=Enum.Font.GothamBold,
        Text=Sub,
        TextColor3=Theme.Accent(),
        TextSize=DPI:F(11),
        TextXAlignment=Enum.TextXAlignment.Left,
        BackgroundTransparency=1,
        BorderSizePixel=0,
        Position=DPI:U2(0,14,0,24),
        Size=DPI:U2(1,-60,0,12),
    },card)

    New("TextLabel",{
        Font=Enum.Font.Gotham,
        Text=Body,
        TextColor3=Theme.TextSec,
        TextSize=DPI:F(11),
        TextXAlignment=Enum.TextXAlignment.Left,
        TextWrapped=true,
        BackgroundTransparency=1,
        BorderSizePixel=0,
        Position=DPI:U2(0,14,0,38),
        Size=DPI:U2(1,-18,0,26),
    },card)

    local barBG = New("Frame",{
        BackgroundColor3=Theme.BGItem,
        BorderSizePixel=0,
        AnchorPoint=Vector2.new(0,1),
        Position=DPI:U2(0,14,1,-6),
        Size=DPI:U2(1,-28,0,DPI:S(4)),
    },card)
    Corner(3,barBG)

    local barFill = New("Frame",{
        BackgroundColor3=Theme.Accent(),
        BorderSizePixel=0,
        Size=UDim2.fromScale(1,1),
    },barBG)
    Corner(3,barFill)
    Gradient(Theme.Grad(),0,barFill)

    local closeBtn = New("TextButton",{
        Font=Enum.Font.GothamBold,
        Text="✕",
        TextColor3=Theme.TextDim,
        TextSize=DPI:F(12),
        AnchorPoint=Vector2.new(1,0),
        BackgroundTransparency=1,
        BorderSizePixel=0,
        Position=UDim2.new(1,-DPI:S(6),0,DPI:S(6)),
        Size=DPI:U2(0,18,0,18),
        ZIndex=5,
        AutoButtonColor=false,
    },card)

    local closed = false
    local function Close()
        if closed then return end
        closed = true
        TweenService:Create(card,TweenInfo.new(Dur,Enum.EasingStyle.Back,Enum.EasingDirection.In),{
            Position=DPI:U2(1,20,0,0),
            BackgroundTransparency=1,
        }):Play()
        task.wait(Dur)
        nFrame:Destroy()
        if #holder:GetChildren()==0 then sg:Destroy() end
    end

    closeBtn.Activated:Connect(Close)
    closeBtn.MouseButton1Down:Connect(function()
        closeBtn.TextColor3 = Theme.Accent()
    end)
    closeBtn.MouseButton1Up:Connect(function()
        closeBtn.TextColor3 = Theme.TextDim
    end)

    TweenService:Create(card,TweenInfo.new(Dur,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{
        Position=UDim2.new(0,0,0,0),
    }):Play()
    card.Position = DPI:U2(1,20,0,0)

    task.spawn(function()
        local steps = 80
        for i=steps,0,-1 do
            if closed then break end
            barFill.Size = UDim2.fromScale(i/steps,1)
            task.wait(Delay/steps)
        end
        Close()
    end)
end

