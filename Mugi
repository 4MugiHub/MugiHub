		local Matches = {}
		for _, e in ipairs(SearchRegistry) do
			if e.TargetFrame and e.TargetFrame.Parent and string.find(string.lower(e.Title), Query, 1, true) then
				table.insert(Matches, e)
				if #Matches >= 8 then break end
