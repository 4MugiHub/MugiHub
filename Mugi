    local Sub     = cfg[2] or ""
    local Body    = cfg[3] or ""
    local Dur     = cfg[5] or 0.35
    local Delay   = cfg[6] or 5

    local sg = New("ScreenGui",{ZIndexBehavior=Enum.ZIndexBehavior.Sibling},GetGuiParent())
    local holder = New("Frame",{
        AnchorPoint            = Vector2.new(1,1),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        Position               = DPI:U2(1,-12,1,-12),
        Size                   = DPI:U2(0,290,1,0),
        Name                   = "NHolder",
    },sg)

    local GAP = DPI:S(8)

    local function Restack()
        local kids = {}
        for _,v in ipairs(holder:GetChildren()) do
            if v:IsA("Frame") and v.Name=="NFrame" then
                table.insert(kids,v)
            end
        end
        local totalY = 0
        local ti = TweenInfo.new(0.22,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
        for i=#kids,1,-1 do
            local v=kids[i]
            TweenService:Create(v,ti,{
                Position=UDim2.new(0,0,1,-(totalY+v.AbsoluteSize.Y))
            }):Play()
            totalY = totalY + v.AbsoluteSize.Y + GAP
        end
    end

    holder.ChildAdded:Connect(Restack)
    holder.ChildRemoved:Connect(Restack)

    local nFrame = New("Frame",{
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        Size                   = DPI:U2(1,0,0,88),
        AnchorPoint            = Vector2.new(0,1),
        Position               = UDim2.new(1,0,1,0),
