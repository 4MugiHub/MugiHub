			function SecFuncs:AddColorPicker(CPConfig)
				local CPName = CPConfig[1] or CPConfig.Name or "Color"
				local Default = CPConfig[2] or CPConfig.Default or Color3.fromRGB(255, 255, 255)
				local Callback = CPConfig[3] or CPConfig.Callback or function() end
				local HEAD, BODYH = 28, 112

				local function ToHSV(C)
					local R, G, B = C.R, C.G, C.B
					local Max, Min = math.max(R, G, B), math.min(R, G, B)
					local D = Max - Min
					local H = 0
					if D > 0 then
						if Max == R then H = ((G - B) / D) % 6
						elseif Max == G then H = (B - R) / D + 2
						else H = (R - G) / D + 4 end
						H = H / 6
					end
					return H, Max == 0 and 0 or D / Max, Max
				end
				local function FromHSV(H, S, V)
					local I = math.floor(H * 6)
					local F = H * 6 - I
					local P, Q, T = V * (1 - S), V * (1 - F * S), V * (1 - (1 - F) * S)
					I = I % 6
					local R, G, B
					if I == 0 then R, G, B = V, T, P
					elseif I == 1 then R, G, B = Q, V, P
					elseif I == 2 then R, G, B = P, V, T
					elseif I == 3 then R, G, B = P, Q, V
					elseif I == 4 then R, G, B = T, P, V
					else R, G, B = V, P, Q end
					return Color3.new(math.clamp(R, 0, 1), math.clamp(G, 0, 1), math.clamp(B, 0, 1))
				end
				local function ToHex(C)
					return string.format("#%02X%02X%02X", math.floor(C.R * 255 + 0.5), math.floor(C.G * 255 + 0.5), math.floor(C.B * 255 + 0.5))
				end
				local function ParseHex(Text)
					Text = string.gsub(tostring(Text), "%s", "")
					local Hex = string.match(Text, "^#?(%x%x%x%x%x%x)$")
					if not Hex then return nil end
					return Color3.fromRGB(tonumber(string.sub(Hex, 1, 2), 16), tonumber(string.sub(Hex, 3, 4), 16), tonumber(string.sub(Hex, 5, 6), 16))
				end

				local CPFrame, CPStroke = Custom:Card(SectionContent, HEAD, CPName .. "ColorPicker", false)
				Place(CPFrame)
				CPFrame.ClipsDescendants = true
				local CPBtn = Custom:Create("TextButton", {
					Text = "", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, HEAD), Name = "ColorBtn",
				}, CPFrame)
				Custom:Label(CPBtn, {
					Text = CPName, TextTruncate = Enum.TextTruncate.AtEnd,
					Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -60, 1, 0), Name = "ColorLabel",
				})
				local Swatch = Custom:Create("Frame", {
					AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = Default, BorderSizePixel = 0,
					Position = UDim2.new(1, -9, 0.5, 0), Size = UDim2.new(0, 30, 0, 15), Name = "Swatch",
				}, CPBtn)
				Custom:Corner(Swatch, 5)
				Custom:Stroke(Swatch, Theme.White, 0.6, 1)

				local CPBody = Custom:Create("Frame", {
					BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, HEAD),
					Size = UDim2.new(1, 0, 0, BODYH), Name = "Body",
				}, CPFrame)
				Custom:Create("Frame", {
					BackgroundColor3 = Theme.White, BackgroundTransparency = 0.92, BorderSizePixel = 0,
					Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -16, 0, 1), Name = "Divider",
				}, CPBody)

				local SVBox = Custom:Create("Frame", {
					BackgroundColor3 = Color3.new(1, 0, 0), BorderSizePixel = 0, ClipsDescendants = true,
					Position = UDim2.new(0, 8, 0, 8), Size = UDim2.new(1, -40, 0, 70), Name = "SVBox",
				}, CPBody)
				Custom:Corner(SVBox, 6)
				local SatLayer = Custom:Create("Frame", {
					BackgroundColor3 = Theme.White, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Name = "SatLayer",
				}, SVBox)
				Custom:Create("UIGradient", {
					Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }), Rotation = 0,
				}, SatLayer)
				local ValLayer = Custom:Create("Frame", {
					BackgroundColor3 = Theme.Black, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Name = "ValLayer",
				}, SVBox)
				Custom:Create("UIGradient", {
					Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }), Rotation = 90,
				}, ValLayer)
				local SVCursor = Custom:Create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.White, BorderSizePixel = 0,
					Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 8, 0, 8), ZIndex = 3, Name = "SVCursor",
				}, SVBox)
				Custom:Round(SVCursor)
				Custom:Stroke(SVCursor, Theme.Black, 0.2, 1.5)

				local HueBar = Custom:Create("Frame", {
					AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Theme.White, BorderSizePixel = 0,
					Position = UDim2.new(1, -8, 0, 8), Size = UDim2.new(0, 20, 0, 70), Name = "HueBar",
				}, CPBody)
				Custom:Corner(HueBar, 6)
				Custom:Create("UIGradient", {
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
						ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
						ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
						ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
						ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
						ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
					}), Rotation = 90,
				}, HueBar)
				local HueCursor = Custom:Create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.White, BorderSizePixel = 0,
					Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(1, 4, 0, 4), ZIndex = 3, Name = "HueCursor",
				}, HueBar)
				Custom:Round(HueCursor)
				Custom:Stroke(HueCursor, Theme.Black, 0.2, 1.5)

				local HexBox = Custom:Create("TextBox", {
					Font = Enum.Font.GothamBold, Text = "", PlaceholderText = "#FFFFFF", PlaceholderColor3 = Theme.Sub,
					TextColor3 = Theme.Text, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = false,
					BackgroundColor3 = Theme.Field, BorderSizePixel = 0, ClipsDescendants = true,
					Position = UDim2.new(0, 8, 0, 84), Size = UDim2.new(1, -16, 0, 20), Name = "HexBox",
				}, CPBody)
				Custom:Corner(HexBox, 6)
				local HexStroke = Custom:Stroke(HexBox, Theme.White, 0.88, 1)

				local H, S, V = ToHSV(Default)
				local Current = Default
				local IsOpen = false

				local function Render()
					Current = FromHSV(H, S, V)
					Swatch.BackgroundColor3 = Current
					SVBox.BackgroundColor3 = FromHSV(H, 1, 1)
					SVCursor.Position = UDim2.new(S, 0, 1 - V, 0)
					HueCursor.Position = UDim2.new(0.5, 0, H, 0)
					HexBox.Text = ToHex(Current)
				end
				Render()

				local function Fire() task.spawn(Callback, Current) end

				local DragMode = nil
				local function FromInput(Input)
					if DragMode == "sv" then
						local P, Sz = SVBox.AbsolutePosition, SVBox.AbsoluteSize
						if Sz.X <= 0 or Sz.Y <= 0 then return end
						S = math.clamp((Input.Position.X - P.X) / Sz.X, 0, 1)
						V = 1 - math.clamp((Input.Position.Y - P.Y) / Sz.Y, 0, 1)
					elseif DragMode == "hue" then
						local P, Sz = HueBar.AbsolutePosition, HueBar.AbsoluteSize
						if Sz.Y <= 0 then return end
						H = math.clamp((Input.Position.Y - P.Y) / Sz.Y, 0, 1)
					else
						return
					end
					Render()
					Fire()
				end
				local function IsPointer(Input)
					return Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch
				end
				SVBox.InputBegan:Connect(function(i)
					if IsPointer(i) then DragMode = "sv" TabFrame.ScrollingEnabled = false FromInput(i) end
				end)
				HueBar.InputBegan:Connect(function(i)
					if IsPointer(i) then DragMode = "hue" TabFrame.ScrollingEnabled = false FromInput(i) end
				end)
				Track(UserInputService.InputChanged:Connect(function(i)
					if DragMode and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then FromInput(i) end
				end))
				Track(UserInputService.InputEnded:Connect(function(i)
					if DragMode and IsPointer(i) then
						DragMode = nil
						TabFrame.ScrollingEnabled = true
					end
				end))

				local function ApplyColor(C, Silent)
					H, S, V = ToHSV(C)
					Render()
					if not Silent then Fire() end
				end

				HexBox.Focused:Connect(function() Custom:Tween(HexStroke, 0.15, { Transparency = 0.3 }) end)
				HexBox.FocusLost:Connect(function()
					Custom:Tween(HexStroke, 0.2, { Transparency = 0.88 })
					local C = ParseHex(HexBox.Text)
					if C then ApplyColor(C, false) else Render() end
				end)

				local function ToggleOpen(State)
					IsOpen = State
					Custom:Tween(CPFrame, 0.22, { Size = UDim2.new(1, 0, 0, State and (HEAD + BODYH) or HEAD) })
					Custom:Tween(CPStroke, 0.2, { Transparency = State and 0.6 or 0.92 })
				end
				CPBtn.Activated:Connect(function()
					CircleClick(CPBtn)
					ToggleOpen(not IsOpen)
				end)
				CPBtn.MouseEnter:Connect(function()
					if not IsOpen then Custom:Tween(CPStroke, 0.15, { Transparency = 0.7 }) end
				end)
				CPBtn.MouseLeave:Connect(function()
					if not IsOpen then Custom:Tween(CPStroke, 0.2, { Transparency = 0.92 }) end
				end)
				RegisterSearch(CPName, CPFrame, Where, SelectTab, EnsureOpen, TabFrame)
				return {
					ColorPicker = CPFrame,
					Set = function(Value)
						if type(Value) == "string" then Value = ParseHex(Value) end
						if Value then ApplyColor(Value, false) end
					end,
					Get = function() return Current end,
					Open = function() ToggleOpen(true) end,
					Close = function() ToggleOpen(false) end,
				}
			end

