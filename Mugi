				Custom:Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, InputBox)
				InputBox.Focused:Connect(function()
					Custom:Tween(BoxStroke, 0.15, { Transparency = 0.15 })
					Custom:Tween(InputStroke, 0.15, { Transparency = 0.5 })
				end)
				InputBox.FocusLost:Connect(function()
					Custom:Tween(BoxStroke, 0.2, { Transparency = 0.85 })
					Custom:Tween(InputStroke, 0.2, { Transparency = 0.9 })
					task.spawn(Callback, InputBox.Text)
				end)
				RegisterSearch(InputName, InputFrame, Where, SelectTab, nil, TabFrame)
				return {
					Input = InputBox,
					Set = function(Text) InputBox.Text = tostring(Text) end,
					Get = function() return InputBox.Text end,
				}
			end

			function SecFuncs:AddDropdown(DropdownConfig)
				local DropdownName = DropdownConfig[1] or DropdownConfig.Name or "Dropdown"
				local Options = DropdownConfig[2] or DropdownConfig.Options or {}
				local Default = DropdownConfig[3] or DropdownConfig.Default or nil
				local Callback = DropdownConfig[4] or DropdownConfig.Callback or function() end
				if type(Default) == "table" then Default = Default[1] end
				if Default ~= nil then Default = tostring(Default) end

				local HEAD, ROW, MAXLIST, FILTERH = 36, 26, 156, 28
				local DropdownFrame, DropdownStroke = Custom:Card(SectionContent, HEAD, DropdownName .. "Dropdown", false)
				Place(DropdownFrame)
				DropdownFrame.ClipsDescendants = true

				local DropdownBtn = Custom:Create("TextButton", {
					Text = "", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, HEAD), Name = "DropdownBtn",
				}, DropdownFrame)
				Custom:Label(DropdownBtn, {
					Text = DropdownName, TextTruncate = Enum.TextTruncate.AtEnd,
					Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(0.5, -12, 1, 0), Name = "DdLabel",
				})
				local ValueLabel = Custom:Label(DropdownBtn, {
					Text = "Select...", TextColor3 = Theme.Sub, TextXAlignment = Enum.TextXAlignment.Right,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.5, -36, 1, 0), Name = "DdValue",
				})
				local Arrow = Custom:Create("Frame", {
					AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0,
					Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 14, 0, 14), Name = "Arrow",
				}, DropdownBtn)
				for _, Rot in ipairs({ 45, -45 }) do
					local Arm = Custom:Create("Frame", {
						AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.Pink, BorderSizePixel = 0,
						Position = UDim2.new(0.5, Rot == 45 and -2.5 or 2.5, 0.5, -1), Rotation = Rot,
						Size = UDim2.new(0, 7, 0, 2), Name = "Arm",
					}, Arrow)
					Custom:Round(Arm)
				end

				local Body = Custom:Create("Frame", {
					BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, HEAD),
					Size = UDim2.new(1, 0, 1, -HEAD), Name = "Body",
				}, DropdownFrame)
				local Divider = Custom:Create("Frame", {
					BackgroundColor3 = Theme.Pink, BackgroundTransparency = 0.9, BorderSizePixel = 0,
					Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 0, 1), Name = "Divider",
				}, Body)

				local Filterable = #Options > 7
				local FilterOffset = Filterable and (FILTERH + 6) or 0
				local FilterBox
				if Filterable then
					FilterBox = Custom:Create("TextBox", {
						Font = Enum.Font.Gotham, Text = "", PlaceholderText = "Filter...", PlaceholderColor3 = Theme.Sub,
						TextColor3 = Theme.Text, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
						BackgroundColor3 = Theme.Field, BorderSizePixel = 0, ClipsDescendants = true,
						Position = UDim2.new(0, 8, 0, 8), Size = UDim2.new(1, -16, 0, FILTERH - 4), Name = "Filter",
					}, Body)
					Custom:Corner(FilterBox, 6)
					Custom:Stroke(FilterBox, Theme.Pink, 0.85, 1)
					Custom:Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, FilterBox)
				end

				local List = Custom:Create("ScrollingFrame", {
					Active = true, BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(0, 0, 0, 0),
					AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Pink,
					ScrollingDirection = Enum.ScrollingDirection.Y,
					Position = UDim2.new(0, 6, 0, 8 + FilterOffset), Size = UDim2.new(1, -12, 0, 0), Name = "OptionHolder",
				}, Body)
				local ListLayout = Custom:Create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, List)

				local IsOpen = false
				local SelectedOption = nil
				local OptionFrames = {}
				local OptionOrder = {}

				local function ListHeight()
					return math.min(ListLayout.AbsoluteContentSize.Y, MAXLIST)
				end
				local function Resize()
					local LH = ListHeight()
					List.Size = UDim2.new(1, -12, 0, LH)
					local Target = HEAD
					if IsOpen then Target = HEAD + 8 + FilterOffset + LH + 8 end
					Custom:Tween(DropdownFrame, 0.22, { Size = UDim2.new(1, 0, 0, Target) })
				end
				ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
					if IsOpen then Resize() end
				end)

				local function Paint(Option, Selected, Animate)
					local OF = OptionFrames[Option]
					if not OF then return end
					local Frame, Bar, Label = OF.Frame, OF.Bar, OF.Label
					local BG = Selected and 0.82 or 1
					local BarSize = Selected and UDim2.new(0, 3, 0, 14) or UDim2.new(0, 3, 0, 0)
					local TC = Selected and Theme.White or Theme.Text
					if Animate then
						Custom:Tween(Frame, 0.18, { BackgroundTransparency = BG })
						Custom:Tween(Bar, 0.2, { Size = BarSize }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
						Custom:Tween(Label, 0.15, { TextColor3 = TC })
					else
						Frame.BackgroundTransparency = BG
						Bar.Size = BarSize
						Label.TextColor3 = TC
					end
				end

				local function ShowValue()
					if SelectedOption then
						ValueLabel.Text = SelectedOption
						ValueLabel.TextColor3 = Theme.Soft
					else
						ValueLabel.Text = "Select..."
						ValueLabel.TextColor3 = Theme.Sub
					end
				end

				local function SelectOption(OptionText, Silent)
					OptionText = tostring(OptionText)
					if not OptionFrames[OptionText] then return end
					if SelectedOption and SelectedOption ~= OptionText then Paint(SelectedOption, false, true) end
					SelectedOption = OptionText
					Paint(OptionText, true, true)
					ShowValue()
					if not Silent then task.spawn(Callback, { OptionText }) end
				end

				local function ToggleList(State)
					IsOpen = State
					Custom:Tween(Arrow, 0.22, { Rotation = State and 180 or 0 })
					Custom:Tween(DropdownStroke, 0.2, { Transparency = State and 0.5 or 0.9 })
					Resize()
				end

				local function ApplyFilter()
					local Q = FilterBox and string.lower(FilterBox.Text) or ""
					for _, Name in ipairs(OptionOrder) do
						local OF = OptionFrames[Name]
						if OF then OF.Frame.Visible = Q == "" or string.find(string.lower(Name), Q, 1, true) ~= nil end
					end
				end
				if FilterBox then FilterBox:GetPropertyChangedSignal("Text"):Connect(ApplyFilter) end

				local function Build(NewOptions)
					for _, OF in pairs(OptionFrames) do OF.Frame:Destroy() end
					OptionFrames = {}
					OptionOrder = {}
					for i, Raw in ipairs(NewOptions) do
						local OptionText = tostring(Raw)
						if not OptionFrames[OptionText] then
							local OFrame = Custom:Create("TextButton", {
								Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.Pink, BackgroundTransparency = 1,
								BorderSizePixel = 0, ClipsDescendants = true, LayoutOrder = i, Size = UDim2.new(1, 0, 0, ROW),
								Name = "Option_" .. OptionText,
							}, List)
							Custom:Corner(OFrame, 6)
							local OBar = Custom:Create("Frame", {
								AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Theme.White, BorderSizePixel = 0,
								Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.new(0, 3, 0, 0), Name = "Indicator",
							}, OFrame)
							Custom:Round(OBar)
							Custom:AddGradient(OBar, 90)
							local OLabel = Custom:Label(OFrame, {
								Font = Enum.Font.GothamMedium, Text = OptionText, TextColor3 = Theme.Text, TextSize = 12,
								TextTruncate = Enum.TextTruncate.AtEnd,
								Position = UDim2.new(0, 16, 0, 0), Size = UDim2.new(1, -22, 1, 0), Name = "OptionLabel",
							})
							OptionFrames[OptionText] = { Frame = OFrame, Bar = OBar, Label = OLabel }
							table.insert(OptionOrder, OptionText)
							OFrame.MouseEnter:Connect(function()
								if SelectedOption ~= OptionText then Custom:Tween(OFrame, 0.12, { BackgroundTransparency = 0.92 }) end
							end)
							OFrame.MouseLeave:Connect(function()
								if SelectedOption ~= OptionText then Custom:Tween(OFrame, 0.15, { BackgroundTransparency = 1 }) end
							end)
							OFrame.Activated:Connect(function()
								CircleClick(OFrame)
								SelectOption(OptionText)
								ToggleList(false)
							end)
						end
					end
					if SelectedOption and OptionFrames[SelectedOption] then
						Paint(SelectedOption, true, false)
					else
						SelectedOption = nil
					end
					ShowValue()
					ApplyFilter()
				end

				Build(Options)
				if Default and OptionFrames[Default] then SelectOption(Default) end

				DropdownBtn.MouseEnter:Connect(function()
					if not IsOpen then Custom:Tween(DropdownStroke, 0.15, { Transparency = 0.55 }) end
				end)
				DropdownBtn.MouseLeave:Connect(function()
					if not IsOpen then Custom:Tween(DropdownStroke, 0.2, { Transparency = 0.9 }) end
				end)
				DropdownBtn.Activated:Connect(function()
					CircleClick(DropdownBtn)
					ToggleList(not IsOpen)
				end)
				RegisterSearch(DropdownName, DropdownFrame, Where, SelectTab, nil, TabFrame)
				return {
					Dropdown = DropdownFrame,
					Set = function(Value)
						if type(Value) == "table" then Value = Value[1] end
						if Value ~= nil then SelectOption(Value) end
					end,
					Get = function() return { SelectedOption } end,
					Refresh = function(NewOptions, Keep)
						if not Keep then SelectedOption = nil end
						Build(NewOptions or {})
						if IsOpen then Resize() end
					end,
					Open = function() ToggleList(true) end,
					Close = function() ToggleList(false) end,
				}
			end

			function SecFuncs:AddKeybind(KeybindConfig)
				local KeybindName = KeybindConfig[1] or KeybindConfig.Name or "Keybind"
				local DefaultKey = KeybindConfig[2] or KeybindConfig.Default or Enum.KeyCode.E
				local Callback = KeybindConfig[3] or KeybindConfig.Callback or function() end
				if type(DefaultKey) == "string" then DefaultKey = Enum.KeyCode[DefaultKey] or Enum.KeyCode.E end
				local KeybindFrame, KeybindStroke = Custom:Card(SectionContent, 36, KeybindName .. "Keybind", false)
				Place(KeybindFrame)
				Custom:Label(KeybindFrame, {
					Text = KeybindName, TextTruncate = Enum.TextTruncate.AtEnd,
					Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -96, 1, 0), Name = "KeybindLabel",
				})
				local KeyBtn = Custom:Create("TextButton", {
					Font = Enum.Font.GothamBold, Text = DefaultKey.Name, TextColor3 = Theme.Soft, TextSize = 11,
					AutoButtonColor = false, BackgroundColor3 = Theme.Field, BorderSizePixel = 0, ClipsDescendants = true,
					AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0, 72, 0, 22), Name = "KeyBtn",
				}, KeybindFrame)
				Custom:Corner(KeyBtn, 6)
				local KeyStroke = Custom:Stroke(KeyBtn, Theme.Pink, 0.8, 1)
				local CurrentKey = DefaultKey
				local Listening = false
				local Conn = nil
				local function Show()
					KeyBtn.Text = CurrentKey.Name
					KeyBtn.TextColor3 = Theme.Soft
					Custom:Tween(KeyStroke, 0.15, { Transparency = 0.8 })
				end
				local function UpdateKey(Key)
					CurrentKey = Key
					Show()
					task.spawn(Callback, Key)
				end
				KeyBtn.Activated:Connect(function()
					if Listening then return end
					Listening = true
					KeyBtn.Text = "..."
					KeyBtn.TextColor3 = Theme.White
					Custom:Tween(KeyStroke, 0.15, { Transparency = 0.1 })
					Conn = Track(UserInputService.InputBegan:Connect(function(i, gp)
						if gp then return end
						if i.UserInputType == Enum.UserInputType.Keyboard then
							Listening = false
							if Conn then Conn:Disconnect() Conn = nil end
							if i.KeyCode == Enum.KeyCode.Escape then Show() else UpdateKey(i.KeyCode) end
						end
					end))
				end)
				Custom:Hover(KeybindFrame, KeybindStroke)
				RegisterSearch(KeybindName, KeybindFrame, Where, SelectTab, nil, TabFrame)
				return {
					Keybind = KeybindFrame,
					Set = function(Key)
						if type(Key) == "string" then
							local ok, v = pcall(function() return Enum.KeyCode[Key] end)
							Key = ok and v or nil
						end
						if Key then UpdateKey(Key) end
					end,
					Get = function() return CurrentKey end,
				}
			end

			local function BuildTextBlock(Config, DefaultTitle, Tag)
				if type(Config) == "table" and Config[1] and Config[2] then
					Config = { Title = Config[1], Text = Config[2] }
				end
				local BlockName = Config[1] or Config.Title or DefaultTitle
				local BlockText = Config[2] or Config.Text or ""
				local Frame = Custom:Card(SectionContent, 30, BlockName .. Tag, false)
				Place(Frame)
				Frame.AutomaticSize = Enum.AutomaticSize.Y
				Custom:Create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, Frame)
				Custom:Create("UIPadding", {
					PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 9), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
				}, Frame)
				local TitleLabel = Custom:Label(Frame, {
					Text = BlockName, TextColor3 = Theme.White, LayoutOrder = 1,
					Size = UDim2.new(1, 0, 0, 16), Name = "Title",
				})
				Custom:AddGradient(TitleLabel, 0)
				local Body = Custom:Label(Frame, {
					Font = Enum.Font.Gotham, Text = tostring(BlockText), TextColor3 = Theme.Sub, TextSize = 11, TextWrapped = true,
					TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, AutomaticSize = Enum.AutomaticSize.Y,
					Size = UDim2.new(1, 0, 0, 14), Name = "Body",
				})
				return Frame, Body
			end

			function SecFuncs:AddParagraph(ParagraphConfig)
				local PF, Body = BuildTextBlock(ParagraphConfig, "Paragraph", "Paragraph")
				return {
					Paragraph = PF,
					Set = function(Text) Body.Text = tostring(Text) end,
				}
			end

			function SecFuncs:AddReadMe(ReadMeConfig)
				local RF = BuildTextBlock(ReadMeConfig, "Read Me", "ReadMe")
				return { ReadMe = RF }
			end

			function SecFuncs:AddSeparator(SeparatorConfig)
				if type(SeparatorConfig) == "string" then SeparatorConfig = { SeparatorConfig } end
				local SeparatorName = SeparatorConfig and (SeparatorConfig[1] or SeparatorConfig.Name) or ""
				local SF = Custom:Create("Frame", {
					BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 14), Name = "Separator",
				}, SectionContent)
				Place(SF)
				if SeparatorName ~= "" then
					local Lbl = Custom:Label(SF, {
						Text = SeparatorName, TextColor3 = Theme.Sub, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center,
						AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
						AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), Name = "SepLabel",
					})
					local Half = Lbl.TextBounds.X / 2 + 8
					for _, Dir in ipairs({ -1, 1 }) do
						Custom:Create("Frame", {
							BackgroundColor3 = Theme.Pink, BackgroundTransparency = 0.8, BorderSizePixel = 0,
							AnchorPoint = Vector2.new(Dir == -1 and 1 or 0, 0.5),
							Position = UDim2.new(0.5, Dir * Half, 0.5, 0), Size = UDim2.new(0.5, -Half, 0, 1), Name = "SepLine",
						}, SF)
					end
				else
					Custom:Create("Frame", {
						BackgroundColor3 = Theme.Pink, BackgroundTransparency = 0.8, BorderSizePixel = 0,
						AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 1), Name = "SepLine",
					}, SF)
				end
				return { Separator = SF }
			end

			function SecFuncs:AddLine()
				local LF = Custom:Create("Frame", {
					BackgroundColor3 = Theme.White, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), Name = "Line",
				}, SectionContent)
				Place(LF)
				Custom:Create("UIGradient", {
					Color = Custom.GradientPink,
					Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) }),
				}, LF)
				return { Line = LF }
			end

			function SecFuncs:AddSocial(SocialConfig)
				local SocialName = SocialConfig[1] or SocialConfig.Name or "Social"
				local SocialUrl = SocialConfig[2] or SocialConfig.Url or ""
				local SocialIcon = SocialConfig[3] or SocialConfig.Icon or ""
				local SF, SStroke = Custom:Card(SectionContent, 36, SocialName .. "Social", true)
				Place(SF)
				if SocialIcon ~= "" then
					Custom:Create("ImageLabel", {
						Image = SocialIcon, AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1,
						BorderSizePixel = 0, Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.new(0, 18, 0, 18), Name = "SocialIcon",
					}, SF)
				end
				Custom:Label(SF, {
					Text = SocialName, TextTruncate = Enum.TextTruncate.AtEnd,
					Position = UDim2.new(0, SocialIcon ~= "" and 38 or 12, 0, 0), Size = UDim2.new(1, SocialIcon ~= "" and -46 or -20, 1, 0), Name = "SocialLabel",
				})
				Custom:Hover(SF, SStroke)
				SF.Activated:Connect(function()
					CircleClick(SF)
					if SocialUrl == "" then return end
					local ok = pcall(function() game:GetService("GuiService"):OpenBrowserWindow(SocialUrl) end)
					if not ok and setclipboard then
						pcall(setclipboard, SocialUrl)
						MugiHub_Library:SetNotification({ Content = "Link copied: " .. SocialUrl })
					end
				end)
				RegisterSearch(SocialName, SF, Where, SelectTab, nil, TabFrame)
				return { Social = SF }
			end

			function SecFuncs:AddCopyGroup(CopyConfig)
				local CopyName = CopyConfig[1] or CopyConfig.Name or "Copy Group"
				local CopyText = CopyConfig[2] or CopyConfig.Text or ""
				local CF, CStroke = Custom:Card(SectionContent, 36, CopyName .. "Copy", false)
				Place(CF)
				Custom:Label(CF, {
					Text = CopyName, TextTruncate = Enum.TextTruncate.AtEnd,
					Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -86, 1, 0), Name = "CopyLabel",
				})
				local CopyBtn = Custom:Create("TextButton", {
					Font = Enum.Font.GothamBold, Text = "Copy", TextColor3 = Theme.Soft, TextSize = 11, AutoButtonColor = false,
					BackgroundColor3 = Theme.Field, BorderSizePixel = 0, ClipsDescendants = true,
					AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0, 54, 0, 22), Name = "CopyBtn",
				}, CF)
				Custom:Corner(CopyBtn, 6)
				local CopyStroke = Custom:Stroke(CopyBtn, Theme.Pink, 0.8, 1)
				CopyBtn.MouseEnter:Connect(function() Custom:Tween(CopyStroke, 0.15, { Transparency = 0.3 }) end)
				CopyBtn.MouseLeave:Connect(function() Custom:Tween(CopyStroke, 0.2, { Transparency = 0.8 }) end)
				CopyBtn.Activated:Connect(function()
					CircleClick(CopyBtn)
					if setclipboard then
						pcall(setclipboard, CopyText)
						MugiHub_Library:SetNotification({ Content = "Copied: " .. CopyText })
					else
						MugiHub_Library:SetNotification({ Content = "Clipboard is not supported by your executor" })
					end
				end)
				Custom:Hover(CF, CStroke)
				RegisterSearch(CopyName, CF, Where, SelectTab, nil, TabFrame)
				return { CopyGroup = CF, Set = function(Text) CopyText = tostring(Text) end }
			end

			return SecFuncs
		end

		return TabFuncs
	end

	Custom:Tween(WindowScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	return Funcs
end

return {
	Library = MugiHub_Library,
	Webhook = MugiWebhook,
}
