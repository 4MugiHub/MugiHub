                    BackgroundColor3 = Custom.ColorRGB,
                    BorderSizePixel = 0,
                    Size = UDim2.new((Default - MinVal) / (MaxVal - MinVal), 0, 1, 0),
                    Name = "BarFill",
                }, BarBg)

