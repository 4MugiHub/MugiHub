      -- /// README / Deskripsi Konten
      -- Style: "Accordion" (collapsible, ada chevron) | "Plain" (statis, di luar accordion) | "Badge" (ringkas dekat tombol)
      function Item:AddReadMe(Config)
        local Title = Config[1] or Config.Title or "README"
        local Content = Config[2] or Config.Content or ""
        local Style = Config[3] or Config.Style or "Accordion"
        local ReadMeFuncs = {}

        if Style == "Badge" then
          -- /// Versi ringkas: pill kecil dekat tombol, di dalam konten
          local Badge = Custom:Create("Frame", {
            Name = "ReadMeBadge",
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = 0.94,
            BorderSizePixel = 0,
            LayoutOrder = ItemCount,
            Size = UDim2.new(1, 0, 0, 26)
          }, SectionAdd)

          Custom:Create("UICorner", {
            CornerRadius = UDim.new(1, 0)
          }, Badge)

          local BadgeIcon = Custom:Create("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = Custom.ColorRGB,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 8, 0.5, 0),
            Size = UDim2.new(0, 6, 0, 6),
            Name = "BadgeIcon"
          }, Badge)
          Custom:Create("UICorner", {CornerRadius = UDim.new(1, 0)}, BadgeIcon)

          local BadgeLabel = Custom:Create("TextLabel", {
            Font = Enum.Font.GothamBold,
            Text = Title .. (Content ~= "" and (" | " .. Content) or ""),
            TextColor3 = Color3.fromRGB(200, 200, 200),
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 20, 0, 0),
            Size = UDim2.new(1, -25, 1, 0),
            Name = "BadgeLabel"
          }, Badge)

          function ReadMeFuncs:Set(NewContent)
            BadgeLabel.Text = Title .. (NewContent ~= "" and (" | " .. NewContent) or "")
          end
          function ReadMeFuncs:SetTitle(NewTitle)
            Title = NewTitle
            BadgeLabel.Text = Title .. (Content ~= "" and (" | " .. Content) or "")
          end

          RegisterSearch(Title, Badge, SearchSubtitle, SelectTab, EnsureSectionOpen, ScrolLayers)
          ItemCount += 1
          return ReadMeFuncs
        end

        local IsAccordion = Style ~= "Plain"
        local Expanded = IsAccordion and (Config.Open or false) or true

        local ReadMe = Custom:Create("Frame", {
          Name = "ReadMe",
          BackgroundColor3 = Color3.fromRGB(255, 255, 255),
          BackgroundTransparency = 0.935,
          BorderSizePixel = 0,
          ClipsDescendants = true,
          LayoutOrder = ItemCount,
          Size = UDim2.new(1, 0, 0, 30)
        }, SectionAdd)

        Custom:Create("UICorner", {
          CornerRadius = UDim.new(0, 4)
        }, ReadMe)

        local HeaderButton = Custom:Create("TextButton", {
          Name = "HeaderButton",
          Font = Enum.Font.SourceSans,
          Text = "",
          TextColor3 = Color3.fromRGB(0, 0, 0),
          BackgroundTransparency = 1,
          BorderSizePixel = 0,
          Size = UDim2.new(1, 0, 0, 30),
          Visible = IsAccordion
        }, ReadMe)

        local ReadMeTitle = Custom:Create("TextLabel", {
          Name = "ReadMeTitle",
          Font = Enum.Font.GothamBold,
          Text = Title,
          TextColor3 = Custom.ColorRGB,
          TextSize = 13,
          TextXAlignment = Enum.TextXAlignment.Left,
          BackgroundTransparency = 1,
          BorderSizePixel = 0,
          Position = UDim2.new(0, 10, 0, 0),
          Size = UDim2.new(1, -40, 0, 30)
        }, ReadMe)

        local Chevron
        if IsAccordion then
          Chevron = Custom:Create("ImageLabel", {
            Image = "rbxassetid://125609963478878",
            ImageColor3 = Custom.ColorRGB,
            AnchorPoint = Vector2.new(1, 0.5),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(1, -10, 0, 15),
            Rotation = Expanded and 90 or -90,
            Size = UDim2.new(0, 12, 0, 12),
            Name = "Chevron"
          }, ReadMe)
        end

        local ReadMeContent = Custom:Create("TextLabel", {
          Name = "ReadMeContent",
          Font = Enum.Font.Gotham,
          Text = Content,
          TextColor3 = Color3.fromRGB(220, 220, 220),
          TextSize = 12,
          TextTransparency = 0.15,
          TextWrapped = true,
          TextXAlignment = Enum.TextXAlignment.Left,
          TextYAlignment = Enum.TextYAlignment.Top,
          BackgroundTransparency = 1,
          BorderSizePixel = 0,
          Position = UDim2.new(0, 10, 0, IsAccordion and 30 or 24),
          Size = UDim2.new(1, -20, 0, 13),
          Name = "ReadMeContent"
        }, ReadMe)

        local function UpdateReadMeSize()
          ReadMeContent.TextWrapped = false
          local lineCount = math.max(math.ceil(ReadMeContent.TextBounds.X / ReadMeContent.AbsoluteSize.X), 1)
          ReadMeContent.Size = UDim2.new(1, -20, 0, 14 * lineCount)
          ReadMeContent.TextWrapped = true

          local HeaderHeight = IsAccordion and 30 or 24
          local FullHeight = HeaderHeight + ReadMeContent.AbsoluteSize.Y + 10

          if Expanded then
            ReadMe.Size = UDim2.new(1, 0, 0, FullHeight)
          else
            ReadMe.Size = UDim2.new(1, 0, 0, HeaderHeight)
          end

          UpdateSizeSection()
        end

        UpdateReadMeSize()
        ReadMeContent:GetPropertyChangedSignal("AbsoluteSize"):Connect(UpdateReadMeSize)

        if IsAccordion then
          HeaderButton.Activated:Connect(function()
            CircleClick(HeaderButton, Player:GetMouse().X, Player:GetMouse().Y)
            Expanded = not Expanded

            TweenService:Create(Chevron, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
              Rotation = Expanded and 90 or -90
            }):Play()

            UpdateReadMeSize()
          end)
        end

        function ReadMeFuncs:Set(NewContent)
          Content = NewContent
          ReadMeContent.Text = NewContent
          UpdateReadMeSize()
        end

        function ReadMeFuncs:SetTitle(NewTitle)
          Title = NewTitle
          ReadMeTitle.Text = NewTitle
        end

        function ReadMeFuncs:SetOpen(IsOpen)
          if IsAccordion and Expanded ~= IsOpen then
            Expanded = IsOpen
            if Chevron then
              TweenService:Create(Chevron, TweenInfo.new(0.2), {Rotation = Expanded and 90 or -90}):Play()
            end
            UpdateReadMeSize()
          end
        end

        RegisterSearch(Title, ReadMe, SearchSubtitle, SelectTab, EnsureSectionOpen, ScrolLayers)

        ItemCount += 1
        return ReadMeFuncs
      end

      ItemCount += 1
      return Item
    end

    CountTab += 1
    return Sections
  end

  -- Gabungkan CreateTab ke Funcs supaya Window punya SEMUA method
  -- (Tags, SetTitle, SetDescription, DAN CreateTab) dalam satu tabel yang sama.
  Funcs.CreateTab = Tabs.CreateTab
  return Funcs
end


