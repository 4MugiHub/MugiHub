					}, OF)
					Custom:Create("UICorner", { CornerRadius = UDim.new(1, 0) }, Ind)
					Custom:AddGradient(Custom:Create("UIStroke", { Color = Custom.ColorRGB, Thickness = 1.5 }, Ind))
