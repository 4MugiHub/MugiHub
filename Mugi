local DPI = {}
do
    local cam     = workspace.CurrentCamera
    local vp      = cam.ViewportSize
    local sH, sW  = vp.Y, vp.X
    local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    local isTablet = UserInputService.TouchEnabled and (sH > 900 or sW > 900)
    local BH, BW
    if isMobile and not isTablet then BH,BW = 380,680
    elseif isTablet               then BH,BW = 500,900
    else                               BH,BW = 600,1080 end
    local raw = math.min(sH/BH, sW/BW)
    local cor
    if isMobile and not isTablet then
        cor = sH>=700 and 0.80 or sH>=550 and 0.88 or sH>=400 and 0.95 or 1.00
    elseif isTablet then
        cor = sH>=800 and 0.85 or 0.92
    else
        cor = sH>=2160 and 0.90 or sH>=1440 and 0.95 or 1.00
    end
    local fs = math.clamp(raw*cor, 0.55, 1.40)
    fs = math.floor(fs/0.05+0.5)*0.05
    DPI.scale    = fs
    DPI.isMobile = isMobile
    DPI.isTablet = isTablet
    DPI.sW, DPI.sH = sW, sH
    function DPI:S(v)  return math.round(v*self.scale) end
    function DPI:U2(xs,xo,ys,yo) return UDim2.new(xs,math.round(xo*self.scale),ys,math.round(yo*self.scale)) end
    function DPI:U(s,o) return UDim.new(s,math.round(o*self.scale)) end
    function DPI:F(v)  return math.max(8,math.round(v*self.scale)) end
    cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        local nv = cam.ViewportSize
        if not isMobile and not isTablet then
            local nr = math.min(nv.Y/600, nv.X/1080)
            DPI.scale = math.floor(math.clamp(nr,0.55,1.40)/0.05+0.5)*0.05
            DPI.sW, DPI.sH = nv.X, nv.Y
        end
    end)
end

