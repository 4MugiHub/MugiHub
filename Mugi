          BackgroundColor3=Color3.fromRGB(255,105,180), BackgroundTransparency=0.55, BorderSizePixel=0,
          AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-8,0.5,0), Size=UDim2.new(0,78,0,25), Name="KeyBox"
        },Keybind)
