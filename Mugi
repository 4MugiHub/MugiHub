local Custom = {} do
  Custom.ColorRGB = Color3.fromRGB(255, 105, 180)

  function Custom:Create(Name, Properties, Parent)
    local _instance = Instance.new(Name)

    for i, v in pairs(Properties) do
      _instance[i] = v
    end

    if Parent then
      _instance.Parent = Parent
    end

    -- MugiHub theme: pink -> white gradient on container backgrounds.
    -- Text objects are intentionally excluded so all text stays solid white.
    if (_instance:IsA("Frame") or _instance:IsA("ScrollingFrame")) and
       _instance.BackgroundTransparency < 1 and
       _instance.Name ~= "SectionDecideFrame" and
       _instance.Name ~= "Seperator" and
       _instance.Name ~= "Line" then
      Custom:ApplyThemeGradient(_instance)
    end

    return _instance
  end

  function Custom:ApplyThemeGradient(Object)
    if Object:FindFirstChild("__MugiHubGradient") then
      return
    end

    Custom:Create("UIGradient", {
      Name = "__MugiHubGradient",
      Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 105, 180)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 182, 193)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
      },
      Rotation = 0
    }, Object)
  end

  function Custom:EnabledAFK()
    Player.Idled:Connect(function()
      VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
      task.wait(1)
      VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
    end)
  end
end

