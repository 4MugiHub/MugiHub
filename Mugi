				Inst = Ok and Made or nil
			end
			if typeof(Inst) ~= "Instance" or not Inst:IsA("GuiObject") then return nil end
			if type(Props) == "table" then
				for K, V in pairs(Props) do pcall(function() Inst[K] = V end) end
