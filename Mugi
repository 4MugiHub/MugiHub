			Collapse.Completed:Wait()
			if Slot and Slot.Parent then Slot:Destroy() end
		end
	end

	function NF:Close() task.spawn(DoClose) end
	return NF
end

MugiHub_Library.Elements = {}
MugiHub_Library.ConfigFolder = "MugiHub"
MugiHub_Library.Flags = setmetatable({}, {
	__index = function(_, Key)
		local E = MugiHub_Library.Elements[Key]
		if E then
			local ok, v = pcall(E.Get)
			if ok then return v end
		end
		return nil
	end,
})

local function ConfigPath(Name)
	return MugiHub_Library.ConfigFolder .. "/" .. tostring(Name) .. ".json"
end

function MugiHub_Library:SaveConfig(Name)
	if not writefile then return false, "writefile is not supported" end
	local Data = {}
	for Flag, E in pairs(self.Elements) do
		local ok, v = pcall(E.Get)
		if ok and v ~= nil then Data[Flag] = E.Encode(v) end
	end
	local ok, Json = pcall(HttpService.JSONEncode, HttpService, Data)
	if not ok then return false, "encode failed" end
	if makefolder and isfolder and not isfolder(self.ConfigFolder) then pcall(makefolder, self.ConfigFolder) end
	local Saved, Err = pcall(writefile, ConfigPath(Name), Json)
	return Saved, Err
end

function MugiHub_Library:LoadConfig(Name)
	if not (readfile and isfile) then return false, "readfile is not supported" end
	local Path = ConfigPath(Name)
	if not isfile(Path) then return false, "config not found" end
	local ok, Raw = pcall(readfile, Path)
	if not ok then return false, "read failed" end
	local ok2, Data = pcall(HttpService.JSONDecode, HttpService, Raw)
	if not ok2 or type(Data) ~= "table" then return false, "decode failed" end
	for Flag, Value in pairs(Data) do
		local E = self.Elements[Flag]
		if E then pcall(function() E.Set(E.Decode(Value)) end) end
	end
	return true
end

function MugiHub_Library:GetConfigs()
	local Result = {}
	if not listfiles then return Result end
	local ok, Files = pcall(listfiles, self.ConfigFolder)
	if not ok or type(Files) ~= "table" then return Result end
	for _, Path in ipairs(Files) do
		local Name = string.match(tostring(Path), "([^/\\]+)%.json$")
		if Name then table.insert(Result, Name) end
	end
	table.sort(Result)
	return Result
end

function MugiHub_Library:DeleteConfig(Name)
	if not (delfile and isfile) then return false end
	local Path = ConfigPath(Name)
	if not isfile(Path) then return false end
	return (pcall(delfile, Path))
end

function MugiHub_Library:Notify(Config)
	return self:SetNotification(Config)
end

