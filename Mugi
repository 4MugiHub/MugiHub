        Custom:Create("UIStroke",{Color=Color3.fromRGB(255,255,255),Thickness=1,Transparency=0.7},KeyBox)
        local Listening=false
        local function norm(v)
          if typeof(v)=="EnumItem" and v.EnumType==Enum.KeyCode then return v end
          if type(v)=="string" then return Enum.KeyCode[v] or Enum.KeyCode.RightShift end
          return Enum.KeyCode.RightShift
        end
        function Funcs_Keybind:Set(v)
          local key=norm(v); Funcs_Keybind.Value=key; Funcs_Keybind.Key=key; KeyBox.Text=key.Name
        end
        KeyBox.Activated:Connect(function() if not Listening then Listening=true; KeyBox.Text="Press key..." end end)
        UserInputService.InputBegan:Connect(function(input,processed)
          if Listening and input.UserInputType==Enum.UserInputType.Keyboard then Listening=false; Funcs_Keybind:Set(input.KeyCode); Callback(input.KeyCode); return end
          if not processed and input.UserInputType==Enum.UserInputType.Keyboard and input.KeyCode==Funcs_Keybind.Key then Callback(Funcs_Keybind.Key) end
        end)
        Funcs_Keybind:Set(Default); ItemCount+=1; return Funcs_Keybind
      end

