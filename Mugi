local Custom = {} do
  -- Warna aksen tunggal: Pink Muda + Putih (gradient), tanpa sistem preset theme.
  -- Pink Muda dipakai SOLID untuk teks/isi/ikon; gradient (Pink Muda -> Putih) khusus untuk elemen "garis" (divider, bar, stroke).
  Custom.ColorRGB = Color3.fromRGB(255, 153, 204) -- Pink Muda (soft pink), senada dengan ring avatar
  Custom.GradientPinkWhite = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 153, 204)), -- Pink Muda
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))  -- Putih
  })

  function Custom:Create(Name, Properties, Parent)
    local _instance = Instance.new(Name)

    for i, v in pairs(Properties) do
      _instance[i] = v
    end

    if Parent then
      _instance.Parent = Parent
    end

    return _instance
  end

  function Custom:EnabledAFK()
    Player.Idled:Connect(function()
      VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
      task.wait(1)
      VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
    end)
  end

  -- Tempel UIGradient Pink -> Putih ke instance manapun (dipakai untuk semua elemen aksen)
  function Custom:AddGradient(Instance, Rotation)
    return Custom:Create("UIGradient", {
      Color = Custom.GradientPinkWhite,
      Rotation = Rotation or 0,
    }, Instance)
  end
end

