		end

		local function ClampPopup()
			local Scr = MugiHubGui.AbsoluteSize
			local Pos, Sz = Frame.AbsolutePosition, Frame.AbsoluteSize
			if Scr.X <= 0 or Scr.Y <= 0 then return end
			local Dx = math.clamp(Pos.X, 0, math.max(Scr.X - Sz.X, 0)) - Pos.X
			local Dy = math.clamp(Pos.Y, 0, math.max(Scr.Y - Sz.Y, 0)) - Pos.Y
			if Dx ~= 0 or Dy ~= 0 then
				local Cur = Frame.Position
				Frame.Position = UDim2.new(Cur.X.Scale, Cur.X.Offset + Dx, Cur.Y.Scale, Cur.Y.Offset + Dy)
			end
		end

		local PDrag, PDragStart, PDragPos = false, nil, nil
		PHead.InputBegan:Connect(function(i)
			if Draggable and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
				PDrag = true
				PDragStart = i.Position
				PDragPos = Frame.Position
				i.Changed:Connect(function()
					if i.UserInputState == Enum.UserInputState.End then
						PDrag = false
						ClampPopup()
					end
				end)
			end
		end)
		Track(UserInputService.InputChanged:Connect(function(i)
			if PDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local d = i.Position - PDragStart
				Frame.Position = UDim2.new(PDragPos.X.Scale, PDragPos.X.Offset + d.X, PDragPos.Y.Scale, PDragPos.Y.Offset + d.Y)
			end
		end))
		Frame.InputBegan:Connect(function(i)
			if POpened and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
				PopupTop = math.min(PopupTop + 1, 90)
				Frame.ZIndex = PopupTop
			end
		end)

		local function SetPopupOpen(State)
			if PDestroyed or Destroyed then return end
			State = State and true or false
			if POpened == State then return end
			POpened = State
			Ticket = Ticket + 1
			local My = Ticket
			if BoundToggle and BoundToggle.Get() ~= State then
				pcall(BoundToggle.Set, State)
			end
			if State then
				PopupTop = math.min(PopupTop + 1, 90)
				Frame.ZIndex = PopupTop
				Frame.Visible = true
				PScale.Scale = Base * 0.9
				Custom:Tween(PScale, 0.25, { Scale = Base }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				if type(OnOpen) == "function" then task.spawn(OnOpen, Popup) end
			else
				PDrag = false
				Custom:Tween(PScale, 0.15, { Scale = Base * 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				task.delay(0.15, function()
					if Ticket == My and not POpened and not PDestroyed then Frame.Visible = false end
				end)
				if type(OnClose) == "function" then task.spawn(OnClose, Popup) end
			end
		end

		PClose.Activated:Connect(function()
			CircleClick(PClose)
			SetPopupOpen(false)
		end)

		function Popup:SetOpen(State) SetPopupOpen(State) end
		function Popup:Open() SetPopupOpen(true) end
		function Popup:Close() SetPopupOpen(false) end
		function Popup:Toggle() SetPopupOpen(not POpened) end
		function Popup:IsOpen() return POpened end
		function Popup:BindToggle(ToggleObj)
			if type(ToggleObj) == "table" and type(ToggleObj.Get) == "function" and type(ToggleObj.Set) == "function" then
				BoundToggle = ToggleObj
				return true
			end
			return false
		end
		function Popup:SetTitle(Text)
			PTitle = tostring(Text)
			PTitleLabel.Text = PTitle
		end
		function Popup:SetIcon(Src) ApplyPopupIcon(Src) end
		function Popup:SetWidth(Value)
			PWidth = math.clamp(tonumber(Value) or PWidth, 180, 800)
			Custom:Tween(Frame, 0.15, { Size = UDim2.new(0, PWidth, 0, PHeight) })
		end
		function Popup:SetHeight(Value)
			PHeight = math.clamp(tonumber(Value) or PHeight, 100, 700)
			Custom:Tween(Frame, 0.15, { Size = UDim2.new(0, PWidth, 0, PHeight) })
		end
		function Popup:SetPosition(Pos)
			if typeof(Pos) == "UDim2" then Frame.Position = Pos end
		end
		function Popup:Destroy()
			if PDestroyed then return end
			PDestroyed = true
			POpened = false
			BoundToggle = nil
			pcall(function() PLoop:Cancel() end)
			pcall(function() Frame:Destroy() end)
		end

		Popup.Frame = Frame
		Popup.Content = PTab.Frame
		Popup.Header = PHead
		table.insert(PopupList, function()
			if POpened and not PDestroyed then Custom:Tween(PScale, 0.2, { Scale = Base }) end
		end)
		if PConfig.Toggle ~= nil then Popup:BindToggle(PConfig.Toggle) end
		if PConfig.Open == true then SetPopupOpen(true) end
		return Popup
	end

