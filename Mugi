                local OptionFrames = {}

                local function UpdateDropdownSize()
                    local TotalHeight = 30
                    if IsOpen then
                        TotalHeight = TotalHeight + OptionLayout.AbsoluteContentSize.Y + 6
                    end
                    TweenService:Create(DropdownFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Size = UDim2.new(1, 0, 0, TotalHeight),
                    }):Play()
                end

                local function SelectOption(OptionText)
                    if SelectedOption then
                        local OldFrame = OptionFrames[SelectedOption]
                        if OldFrame then
                            local OldInd = OldFrame:FindFirstChild("Indicator")
                            if OldInd then
                                TweenService:Create(OldInd, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                                    Size = UDim2.new(0, 0, 0, 12),
                                }):Play()
                                task.delay(0.15, function()
                                    if OldInd then OldInd.Visible = false end
                                end)
                            end
                        end
                    end

                    SelectedOption = OptionText
                    local NewFrame = OptionFrames[OptionText]
                    if NewFrame then
                        local NewInd = NewFrame:FindFirstChild("Indicator")
                        if NewInd then
                            NewInd.Visible = true
                            TweenService:Create(NewInd, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                                Size = UDim2.new(0, 3, 0, 16),
                            }):Play()
                        end
                    end

                    DdLabel.Text = DropdownName .. ": " .. OptionText
                    DdLabel.TextColor3 = Custom.ColorRGB
