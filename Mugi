  -- /// Daftarkan sebuah item ke Search Registry
  local function RegisterSearch(EntryTitle, TargetFrame, Subtitle, SelectTabFn, EnsureOpenFn, ScrollFrameRef)
    if EntryTitle == "" then return end
    table.insert(SearchRegistry, {
      Title = EntryTitle,
      Subtitle = Subtitle or "",
      TargetFrame = TargetFrame,
      SelectTab = SelectTabFn,
      EnsureOpen = EnsureOpenFn,
      ScrollFrame = ScrollFrameRef
    })
  end

