                    local iF=New("Frame",{BackgroundColor3=Theme.BGSec,BorderSizePixel=0,AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-DPI:S(10),0.5,0),Size=DPI:U2(0,24,0,24),ZIndex=2},f)
                    Corner(6,iF)
                    New("ImageLabel",{Image=BI,ImageColor3=Theme.Accent(),BackgroundTransparency=1,BorderSizePixel=0,AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),Size=UDim2.fromScale(0.75,0.75),ZIndex=3},iF)
                end
                local tb=New("TextButton",{Text="",BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ZIndex=4},f)
                tb.Activated:Connect(function()
                    Ripple(tb,Player:GetMouse().X,Player:GetMouse().Y)
                    TweenService:Create(f,TweenInfo.new(0.08),{BackgroundColor3=Theme.BGSec}):Play()
                    task.wait(0.08)
                    TweenService:Create(f,TweenInfo.new(0.12),{BackgroundColor3=Theme.BGItem}):Play()
                    BF()
                end)
                ICount+=1; return {}
            end

            function I:AddSlider(c)
                local ST=c[1]or"" local SC=c[2]or"" local SI=c[3]or 1 local SMn=c[4]or 0 local SMx=c[5]or 100 local SD=c[6]or 50 local SF=c[7]or function()end
                local sFuncs={Value=SD}
                local f=BaseItem(48)
                New("TextLabel",{Font=Enum.Font.GothamBold,Text=ST,TextColor3=Theme.TextPri,TextSize=DPI:F(12),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,BorderSizePixel=0,Position=DPI:U2(0,10,0,7),Size=DPI:U2(1,-80,0,14),ZIndex=2},f)
                New("TextLabel",{Font=Enum.Font.Gotham,Text=SC,TextColor3=Theme.TextDim,TextSize=DPI:F(10),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,BorderSizePixel=0,Position=DPI:U2(0,10,0,20),Size=DPI:U2(1,-80,0,12),ZIndex=2},f)
                local valBox=New("TextBox",{Font=Enum.Font.GothamBold,Text="0",TextColor3=Theme.BG,TextSize=DPI:F(10),BackgroundColor3=Theme.Accent(),BorderSizePixel=0,AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-DPI:S(8),0,DPI:S(6)),Size=DPI:U2(0,32,0,18),ZIndex=3},f)
                Corner(4,valBox)
                Gradient(Theme.Grad(),0,valBox)
                local track=New("Frame",{BackgroundColor3=Theme.BGSec,BorderSizePixel=0,AnchorPoint=Vector2.new(0.5,1),Position=UDim2.new(0.5,0,1,-DPI:S(7)),Size=DPI:U2(1,-20,0,4),ZIndex=2},f)
                Corner(3,track)
                local fill=New("Frame",{BackgroundColor3=Theme.Accent(),BorderSizePixel=0,Size=UDim2.fromScale(0.5,1),ZIndex=3},track)
                Corner(3,fill)
                Gradient(Theme.Grad(),0,fill)
                local dot=New("Frame",{BackgroundColor3=Theme.TextPri,BorderSizePixel=0,AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(0.5,DPI:S(4),0.5,0),Size=DPI:U2(0,9,0,9),ZIndex=4},fill)
                Corner(5,dot)
                Stroke(Theme.Accent(),1,0,dot)
                local function Rnd(n,fac) return math.clamp(math.floor(n/fac+0.5)*fac,SMn,SMx) end
                function sFuncs:Set(v)
                    v=Rnd(v,SI); sFuncs.Value=v
                    valBox.Text=tostring(v)
                    fill.Size=UDim2.fromScale((v-SMn)/math.max(SMx-SMn,1),1)
                end
                local drag=false
                local function GX(x) return math.clamp((x-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1) end
                track.InputBegan:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
                        drag=true; sFuncs:Set(SMn+(SMx-SMn)*GX(i.Position.X))
                    end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
                        sFuncs:Set(SMn+(SMx-SMn)*GX(i.Position.X))
                    end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if drag and (i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch) then
                        drag=false; SF(sFuncs.Value)
                    end
                end)
                valBox.FocusLost:Connect(function() sFuncs:Set(tonumber(valBox.Text) or SMn); SF(sFuncs.Value) end)
                sFuncs:Set(SD); SF(SD)
                ICount+=1; return sFuncs
            end

            function I:AddInput(c)
                local IT=c[1]or"" local IP=c[2]or"" local ID=c[3]or"" local IF=c[4]or function()end
                local iFuncs={Value=ID}
                local f=BaseItem(48)
                New("TextLabel",{Font=Enum.Font.GothamBold,Text=IT,TextColor3=Theme.TextPri,TextSize=DPI:F(12),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,BorderSizePixel=0,Position=DPI:U2(0,10,0,7),Size=DPI:U2(1,-16,0,14),ZIndex=2},f)
                local inpF=New("Frame",{BackgroundColor3=Theme.BGSec,BorderSizePixel=0,AnchorPoint=Vector2.new(0.5,1),Position=UDim2.new(0.5,0,1,-DPI:S(7)),Size=DPI:U2(1,-20,0,22),ClipsDescendants=true,ZIndex=2},f)
                Corner(5,inpF)
                local iStroke=Stroke(Theme.Stroke,1,0,inpF)
                local tb=New("TextBox",{Font=Enum.Font.Gotham,PlaceholderText=IP,PlaceholderColor3=Theme.TextDim,Text=ID,TextColor3=Theme.TextPri,TextSize=DPI:F(11),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,BorderSizePixel=0,AnchorPoint=Vector2.new(0,0.5),Position=DPI:U2(0,7,0.5,0),Size=DPI:U2(1,-14,1,-4),ZIndex=3},inpF)
                tb.Focused:Connect(function() TweenService:Create(iStroke,TweenInfo.new(0.15),{Color=Theme.Accent()}):Play() end)
                tb.FocusLost:Connect(function() TweenService:Create(iStroke,TweenInfo.new(0.15),{Color=Theme.Stroke}):Play(); iFuncs:Set(tb.Text) end)
                function iFuncs:Set(v) tb.Text=v; iFuncs.Value=v; IF(v) end
                ICount+=1; return iFuncs
            end

            function I:AddDropdown(c)
                local DT=c[1]or"" local DC=c[2]or"" local DM=c[3]or false local DO=c[4]or{} local DDef=c[5]or{} local DF=c[6]or function()end
                local dFuncs={Value=DDef,Options=DO}
                local f=BaseItem(38)
                New("TextLabel",{Font=Enum.Font.GothamBold,Text=DT,TextColor3=Theme.TextPri,TextSize=DPI:F(12),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,BorderSizePixel=0,AnchorPoint=Vector2.new(0,0.5),Position=DPI:U2(0,10,0.5,-7),Size=DPI:U2(1,-160,0,14),ZIndex=2},f)
                New("TextLabel",{Font=Enum.Font.Gotham,Text=DC,TextColor3=Theme.TextDim,TextSize=DPI:F(10),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,BorderSizePixel=0,AnchorPoint=Vector2.new(0,0.5),Position=DPI:U2(0,10,0.5,7),Size=DPI:U2(1,-160,0,12),ZIndex=2},f)
                local selF=New("Frame",{BackgroundColor3=Theme.BGSec,BorderSizePixel=0,AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-DPI:S(8),0.5,0),Size=DPI:U2(0,140,0,26),ClipsDescendants=true,ZIndex=2},f)
                Corner(5,selF)
                Stroke(Theme.Stroke,1,0,selF)
                local selLbl=New("TextLabel",{Font=Enum.Font.Gotham,Text="Pilih...",TextColor3=Theme.TextDim,TextSize=DPI:F(11),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,BorderSizePixel=0,AnchorPoint=Vector2.new(0,0.5),Position=DPI:U2(0,6,0.5,0),Size=DPI:U2(1,-28,1,-4),ZIndex=3},selF)
                New("TextLabel",{Font=Enum.Font.GothamBold,Text="›",TextColor3=Theme.Accent(),TextSize=DPI:F(14),AnchorPoint=Vector2.new(1,0.5),BackgroundTransparency=1,BorderSizePixel=0,Position=UDim2.new(1,-DPI:S(4),0.5,0),Size=DPI:U2(0,14,1,0),ZIndex=3},selF)

                local dropFrame=New("Frame",{BackgroundColor3=Theme.BGCard,BorderSizePixel=0,Position=UDim2.new(0,0,1,DPI:S(4)),Size=DPI:U2(1,0,0,0),ClipsDescendants=true,ZIndex=10,Visible=false},f)
                Corner(7,dropFrame)
                Stroke(Theme.Accent(),1,0.3,dropFrame)
                local dropScroll=New("ScrollingFrame",{ScrollBarThickness=DPI:S(2),ScrollBarImageColor3=Theme.Accent(),CanvasSize=UDim2.new(0,0,0,0),BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ZIndex=11},dropFrame)
                New("UIListLayout",{Padding=UDim.new(0,DPI:S(2)),SortOrder=Enum.SortOrder.LayoutOrder},dropScroll)
                local searchDrop=New("TextBox",{Font=Enum.Font.Gotham,PlaceholderText="Cari...",PlaceholderColor3=Theme.TextDim,Text="",TextColor3=Theme.TextPri,TextSize=DPI:F(11),BackgroundColor3=Theme.BGSec,BackgroundTransparency=0,BorderSizePixel=0,Size=DPI:U2(1,0,0,24),ZIndex=12,ClearTextOnFocus=false},dropScroll)
                Corner(0,searchDrop)
                Padding(6,0,0,0,searchDrop)

                local isOpen=false
                local function ToggleDrop()
                    isOpen=not isOpen
                    local ti=TweenInfo.new(0.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
                    if isOpen then
                        dropFrame.Visible=true
                        local dh=math.min(#DO*DPI:S(28)+DPI:S(26),DPI:S(120))
                        TweenService:Create(dropFrame,ti,{Size=DPI:U2(1,0,0,dh)}):Play()
                        TweenService:Create(f,ti,{Size=DPI:U2(1,0,0,38+dh+DPI:S(4))}):Play()
                    else
                        TweenService:Create(dropFrame,ti,{Size=DPI:U2(1,0,0,0)}):Play()
                        TweenService:Create(f,ti,{Size=DPI:U2(1,0,0,38)}):Play()
                        task.wait(0.18); dropFrame.Visible=false
                    end
                    task.wait(0.2); UpdateScrollCanvas()
                end

                local selBtn=New("TextButton",{Text="",BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ZIndex=4},selF)
                selBtn.Activated:Connect(ToggleDrop)

                searchDrop:GetPropertyChangedSignal("Text"):Connect(function()
                    local q=string.lower(searchDrop.Text)
                    for _,v in pairs(dropScroll:GetChildren()) do
                        if v:IsA("Frame") then
                            local lt=v:FindFirstChildOfClass("TextLabel")
                            if lt then v.Visible=(q=="" or string.find(string.lower(lt.Text),q,1,true)~=nil) end
                        end
                    end
                end)

                function dFuncs:Set(val)
                    dFuncs.Value=val or dFuncs.Value
                    for _,opt in pairs(dropScroll:GetChildren()) do
                        if opt:IsA("Frame") then
                            local lt=opt:FindFirstChildOfClass("TextLabel")
                            local cf=opt:FindFirstChild("ChooseDot")
                            local found=lt and table.find(dFuncs.Value,lt.Text)
                            if cf then
                                TweenService:Create(cf,TweenInfo.new(0.15),{BackgroundColor3=found and Theme.Accent() or Theme.TextDim,Size=found and DPI:U2(0,8,0,8) or DPI:U2(0,6,0,6)}):Play()
                            end
                            TweenService:Create(opt,TweenInfo.new(0.15),{BackgroundTransparency=found and 0.7 or 0.999}):Play()
                        end
                    end
                    selLbl.Text=table.concat(dFuncs.Value,", ")
                    if selLbl.Text=="" then selLbl.Text="Pilih..." end
                    DF(dFuncs.Value)
                end

                function dFuncs:AddOption(name)
                    local opt=New("Frame",{BackgroundColor3=Theme.Accent(),BackgroundTransparency=0.999,BorderSizePixel=0,Size=DPI:U2(1,0,0,28),ZIndex=11},dropScroll)
                    Corner(5,opt)
                    local cd=New("Frame",{Name="ChooseDot",BackgroundColor3=Theme.TextDim,BorderSizePixel=0,AnchorPoint=Vector2.new(0,0.5),Position=DPI:U2(0,8,0.5,0),Size=DPI:U2(0,6,0,6),ZIndex=12},opt)
                    Corner(4,cd)
                    New("TextLabel",{Font=Enum.Font.Gotham,Text=name,TextColor3=Theme.TextPri,TextSize=DPI:F(11),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,BorderSizePixel=0,AnchorPoint=Vector2.new(0,0.5),Position=DPI:U2(0,20,0.5,0),Size=DPI:U2(1,-24,1,0),ZIndex=12},opt)
                    local ob=New("TextButton",{Text="",BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ZIndex=13},opt)
                    ob.Activated:Connect(function()
                        Ripple(ob,Player:GetMouse().X,Player:GetMouse().Y)
                        local alreadySel=table.find(dFuncs.Value,name)~=nil
                        if DM then
                            if not alreadySel then table.insert(dFuncs.Value,name)
                            else for i,v in ipairs(dFuncs.Value) do if v==name then table.remove(dFuncs.Value,i);break end end end
                        else dFuncs.Value={name} end
                        dFuncs:Set(dFuncs.Value)
                    end)
                    local h=0
                    for _,v in pairs(dropScroll:GetChildren()) do if v:IsA("Frame") then h=h+DPI:S(2)+v.Size.Y.Offset end end
                    dropScroll.CanvasSize=UDim2.new(0,0,0,h)
                end

                function dFuncs:Clear()
                    for _,v in pairs(dropScroll:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
                    dFuncs.Value={}; dFuncs.Options={}
                    selLbl.Text="Pilih..."
                end

                function dFuncs:Refresh(list,sel)
                    dFuncs:Clear()
                    for _,v in ipairs(list or {}) do dFuncs:AddOption(v) end
                    dFuncs.Options=list or {}
                    dFuncs:Set(sel or {})
                end

                dFuncs:Refresh(DO,DDef)
                ICount+=1; return dFuncs
            end

            function I:AddParagraph(c)
                local PT=c[1]or"" local PC=c[2]or""
                local f=BaseItem(38)
                local tl=New("TextLabel",{Font=Enum.Font.GothamBold,Text=PT,TextColor3=Theme.TextPri,TextSize=DPI:F(12),TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,BackgroundTransparency=1,BorderSizePixel=0,Position=DPI:U2(0,10,0,8),Size=DPI:U2(1,-16,0,14),ZIndex=2},f)
                local cl=New("TextLabel",{Font=Enum.Font.Gotham,Text=PC,TextColor3=Theme.TextSec,TextSize=DPI:F(10),TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,TextWrapped=true,BackgroundTransparency=1,BorderSizePixel=0,Position=DPI:U2(0,10,0,23),Size=DPI:U2(1,-16,0,12),ZIndex=2},f)
                local pFuncs={}
                local function Upd()
                    cl.TextWrapped=false
                    local lines=math.ceil(cl.TextBounds.X/math.max(cl.AbsoluteSize.X,1))
                    cl.Size=DPI:U2(1,-16,0,DPI:S(11)*(lines+1))
                    f.Size=DPI:U2(1,0,0,cl.AbsoluteSize.Y+DPI:S(30))
                    cl.TextWrapped=true
                    UpdateScrollCanvas()
                end
                Upd()
                cl:GetPropertyChangedSignal("AbsoluteSize"):Connect(Upd)
                function pFuncs:Set(c2) tl.Text=c2[1]or""; cl.Text=c2[2]or""; Upd() end
                ICount+=1; return pFuncs
            end

            function I:AddSeperator(c)
                local ST=c[1]or""
                local f=New("Frame",{BackgroundColor3=Theme.BGSec,BorderSizePixel=0,LayoutOrder=ICount,Size=DPI:U2(1,0,0,26),ZIndex=2},itemsFrame)
                Corner(5,f)
                Gradient(Theme.GradBG(),0,f)
                New("TextLabel",{Font=Enum.Font.GothamBold,Text=ST,TextColor3=Theme.TextSec,TextSize=DPI:F(11),TextXAlignment=Enum.TextXAlignment.Center,BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ZIndex=3},f)
                ICount+=1; return {}
            end

            function I:AddLine()
                local f=New("Frame",{BackgroundColor3=Theme.Accent(),BackgroundTransparency=0.5,BorderSizePixel=0,LayoutOrder=ICount,Size=DPI:U2(1,0,0,DPI:S(2)),ZIndex=2},itemsFrame)
                Corner(2,f)
                Gradient(Theme.GradBG(),0,f)
                ICount+=1; return {}
            end

            function I:AddCardButton(c)
                local CT=c[1]or"" local CC=c[2]or"" local CF=c[3]or function()end
                local f=New("Frame",{BackgroundColor3=Theme.BGCard,BorderSizePixel=0,LayoutOrder=ICount,Size=DPI:U2(1,0,0,44),ZIndex=2},itemsFrame)
                Corner(8,f)
                Stroke(Theme.Stroke,1,0.4,f)
                New("TextLabel",{Font=Enum.Font.GothamBold,Text=CT,TextColor3=Theme.TextPri,TextSize=DPI:F(12),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,BorderSizePixel=0,AnchorPoint=Vector2.new(0,0.5),Position=DPI:U2(0,14,0.5,-7),Size=DPI:U2(1,-20,0,14),ZIndex=3},f)
                New("TextLabel",{Font=Enum.Font.Gotham,Text=CC,TextColor3=Theme.TextDim,TextSize=DPI:F(10),TextXAlignment=Enum.TextXAlignment.Left,BackgroundTransparency=1,BorderSizePixel=0,AnchorPoint=Vector2.new(0,0.5),Position=DPI:U2(0,14,0.5,7),Size=DPI:U2(1,-20,0,12),ZIndex=3},f)
                local tb=New("TextButton",{Text="",BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ZIndex=4},f)
                tb.Activated:Connect(function()
                    Ripple(tb,Player:GetMouse().X,Player:GetMouse().Y)
                    TweenService:Create(f,TweenInfo.new(0.08),{BackgroundColor3=Theme.BGSec}):Play()
                    task.wait(0.1); TweenService:Create(f,TweenInfo.new(0.12),{BackgroundColor3=Theme.BGCard}):Play()
                    CF()
                end)
                ICount+=1; return {}
            end

            SecCount+=1
            return I
        end

        function S:AddPageSection(thumbUrl)
            local pg = New("Frame",{
                BackgroundTransparency = 1,
                BorderSizePixel        = 0,
                LayoutOrder            = SecCount,
                Size                   = UDim2.new(1,0,0,DPI:S(4)),
            },pageScroll)
            if thumbUrl and thumbUrl~="" then
                local imgF=New("Frame",{BackgroundTransparency=1,BorderSizePixel=0,Size=DPI:U2(1,0,0,DPI:S(80)),LayoutOrder=SecCount},pageScroll)
                local img=New("ImageLabel",{Image=thumbUrl,BackgroundColor3=Theme.BGItem,BackgroundTransparency=0.3,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ScaleType=Enum.ScaleType.Crop},imgF)
                Corner(10,img)
                SecCount+=1
                task.defer(UpdateScrollCanvas)
            end
            local btnHolder=New("Frame",{BackgroundTransparency=1,BorderSizePixel=0,LayoutOrder=SecCount,Size=UDim2.new(1,0,0,DPI:S(4))},pageScroll)
            New("UIListLayout",{Padding=UDim.new(0,DPI:S(5)),SortOrder=Enum.SortOrder.LayoutOrder},btnHolder)
            local BH={}
            function BH:AddButton(c)
                local BT=c[1]or"" local BF=c[2]or function()end
                local bH=DPI:S(40)
                local bF=New("Frame",{BackgroundColor3=Theme.BGCard,BorderSizePixel=0,LayoutOrder=#btnHolder:GetChildren(),Size=DPI:U2(1,0,0,bH),ZIndex=2},btnHolder)
                Corner(8,bF)
                Stroke(Theme.Stroke,1,0.3,bF)
                New("TextLabel",{Font=Enum.Font.GothamBold,Text=BT,TextColor3=Theme.TextPri,TextSize=DPI:F(12),TextXAlignment=Enum.TextXAlignment.Center,BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ZIndex=3},bF)
                local tb=New("TextButton",{Text="",BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.fromScale(1,1),ZIndex=4},bF)
                tb.Activated:Connect(function()
                    Ripple(tb,Player:GetMouse().X,Player:GetMouse().Y)
                    TweenService:Create(bF,TweenInfo.new(0.08),{BackgroundColor3=Theme.BGSec}):Play()
                    task.wait(0.1); TweenService:Create(bF,TweenInfo.new(0.12),{BackgroundColor3=Theme.BGCard}):Play()
                    BF()
                end)
                local h=0
                for _,v in pairs(btnHolder:GetChildren()) do if v.Name~="UIListLayout" then h=h+DPI:S(5)+v.Size.Y.Offset end end
                btnHolder.Size=DPI:U2(1,0,0,h)
                pg.Size=DPI:U2(1,0,0,DPI:S(4))
                task.defer(UpdateScrollCanvas)
            end
            SecCount+=1
            return BH
        end

        TabCount+=1
        return S
    end

    function W:SetTheme(name)
        ApplyTheme(name)
        for _,d in pairs(Main:GetDescendants()) do
            pcall(function()
                if d:IsA("UIGradient") then d.Color=Theme.Grad() end
            end)
        end
    end

    function W:SetThumbnail(url) SetThumb(url or "") end
    function W:SetTabThumbnail(idx,url) TabThumbs[idx]=url or "" end
    function W:AddTag(text,color) return AddTag(text,color) end

    return W
end

return MugiHub
