function Theme.Accent()  return AP.A end
function Theme.AccentM() return AP.M end
function Theme.AccentW() return AP.W end
function Theme.Grad()
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0,   AP.A),
        ColorSequenceKeypoint.new(0.55,AP.M),
        ColorSequenceKeypoint.new(1,   AP.W),
    })
end
function Theme.GradBG()
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(13,13,18)),
        ColorSequenceKeypoint.new(0.5, AP.A),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(13,13,18)),
    })
end

local ThemeCBs = {}
local function ApplyTheme(name)
    local p = ThemePresets[name]
    if not p then return end
    AP = p
    for _,fn in pairs(ThemeCBs) do pcall(fn, p) end
end
local function OnThemeChange(fn) table.insert(ThemeCBs, fn) end

local function New(cls, props, parent)
    local i = Instance.new(cls)
    if parent then i.Parent = parent end
    for k,v in pairs(props) do i[k]=v end
    return i
end

local function Corner(r, p) return New("UICorner",{CornerRadius=DPI:U(0,r)},p) end
local function Stroke(c,t,tr,p)
    return New("UIStroke",{Color=c,Thickness=t,Transparency=tr or 0},p)
end
local function Gradient(cs,rot,p)
    return New("UIGradient",{Color=cs,Rotation=rot or 0},p)
end
local function Padding(l,r,t,b,p)
    return New("UIPadding",{
        PaddingLeft  = DPI:U(0,l or 0),
        PaddingRight = DPI:U(0,r or 0),
        PaddingTop   = DPI:U(0,t or 0),
        PaddingBottom= DPI:U(0,b or 0),
    },p)
end

local function GetGuiParent()
    if RunService:IsStudio() then
        return Player:WaitForChild("PlayerGui")
    end
    local ok,r = pcall(function() if gethui then return gethui() end end)
    if ok and r then return r end
    local ok2,r2 = pcall(function() if cloneref then return cloneref(game:GetService("CoreGui")) end end)
    if ok2 and r2 then return r2 end
    local ok3,r3 = pcall(function() return game:GetService("CoreGui") end)
    if ok3 and r3 then return r3 end
    return Player:WaitForChild("PlayerGui")
end

local function Ripple(btn, x, y)
    task.spawn(function()
        btn.ClipsDescendants = true
        local c = New("ImageLabel",{
            Image="rbxassetid://106471194043211",
            ImageColor3=Color3.fromRGB(255,255,255),
            ImageTransparency=0.88,
            BackgroundTransparency=1,
            ZIndex=10,Name="Rpl",
        },btn)
        local nx = x - btn.AbsolutePosition.X
        local ny = y - btn.AbsolutePosition.Y
        c.Position = UDim2.new(0,nx,0,ny)
        local sz = math.max(btn.AbsoluteSize.X,btn.AbsoluteSize.Y)*1.6
        TweenService:Create(c,TweenInfo.new(0.45,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{
            Size=UDim2.new(0,sz,0,sz),
            Position=UDim2.new(0.5,-sz/2,0.5,-sz/2),
            ImageTransparency=1,
        }):Play()
        task.wait(0.45)
        c:Destroy()
    end)
end

