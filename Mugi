					AnchorPoint = Vector2.new(1, 0.5),
					BackgroundColor3 = Custom.ColorRGB,
					BorderColor3 = Color3.fromRGB(0, 0, 0),
					BorderSizePixel = 0,
					Position = UDim2.new(1, 4, 0.5, 0),
					Size = UDim2.new(0, 8, 0, 8),
					Name = "SliderCircle",
				}, SliderDraggable)

        Custom:Create("UICorner", {}, SliderCircle)

        Custom:Create("UIStroke", {
          Color = Custom.ColorRGB,
        }, SliderCircle)

        local Dragging = false

        local function Round(Number, Factor)
          local Result = math.floor(Number / Factor + (math.sign(Number) * 0.5)) * Factor
          if Result < 0 then 
            Result = Result + Factor 
          end
          return Result
        end
        
        -- Animate=false dipakai SAAT DRAG (langsung, tanpa tween) biar smooth di mobile —
        -- bikin Tween baru di SETIAP pixel gerakan jari itu berat & bikin patah-patah.
        -- Animate=true dipakai untuk update terprogram (Set manual, submit dari TextBox, dsb).
        function Funcs_Slider:Set(Value, Animate)
          Value = math.clamp(Round(Value, Increment), Min, Max)
          Funcs_Slider.Value = Value

          if TextBox.Text ~= tostring(Value) then
            TextBox.Text = tostring(Value)
          end

          local TargetSize = UDim2.fromScale((Value - Min) / (Max - Min), 1)
          if Animate then
            TweenService:Create(SliderDraggable, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = TargetSize }):Play()
          else
            SliderDraggable.Size = TargetSize
          end
        end
        
        SliderFrame.InputBegan:Connect(function(Input)
          if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true
          end
        end)
      
        SliderFrame.InputEnded:Connect(function(Input)
          if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            Dragging = false
            Callback(Funcs_Slider.Value)
          end
        end)
      
        local _LastX = nil
        UserInputService.InputChanged:Connect(function(Input)
          if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
            local CurrPosX = Input.Position.X
            if CurrPosX ~= _LastX then
              _LastX = CurrPosX
      
              local SizeScale = math.clamp((CurrPosX - SliderFrame.AbsolutePosition.X) / SliderFrame.AbsoluteSize.X, 0, 1)
              Funcs_Slider:Set(Min + ((Max - Min) * SizeScale), false)
            end
          end
        end)
        
        TextBox:GetPropertyChangedSignal("Text"):Connect(function()
          local Valid = TextBox.Text:gsub("[^%d]", "")
          if Valid ~= "" then
            local ValidNumber = math.min(tonumber(Valid), Max)
            if TextBox.Text ~= tostring(ValidNumber) then
              TextBox.Text = tostring(ValidNumber)
            end
          else
            TextBox.Text = "0"
          end
        end)
        
        TextBox.FocusLost:Connect(function()
          if TextBox.Text ~= "" then
            Funcs_Slider:Set(tonumber(TextBox.Text), true)
            Callback(Funcs_Slider.Value)
          else
            Funcs_Slider:Set(0, true)
            Callback(Funcs_Slider.Value)
          end
        end)
        
        Funcs_Slider:Set(tonumber(Default), true)
        Callback(Funcs_Slider.Value)

        RegisterSearch(Title, Slider, SearchSubtitle, SelectTab, EnsureSectionOpen, ScrolLayers)

        ItemCount += 1
				return Funcs_Slider
      end

