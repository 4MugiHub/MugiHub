        }, CopyIcon)
        Custom:Create("UICorner", {CornerRadius = UDim.new(0, 2)}, CopyFront)
        local CopyFrontStroke = Custom:Create("UIStroke", {
          Color = Color3.fromRGB(200, 200, 200),
          Thickness = 1.3
        }, CopyFront)

        local CopyLabel = Custom:Create("TextLabel", {
          Font = Enum.Font.GothamBold,
          Text = "Copy",
          TextColor3 = Color3.fromRGB(220, 220, 220),
          TextSize = 12,
          TextXAlignment = Enum.TextXAlignment.Left,
          BackgroundTransparency = 1,
          Position = UDim2.new(0, 24, 0, 0),
          Size = UDim2.new(1, -28, 1, 0),
          Name = "CopyLabel"
        }, CopyButton)

        local ClickGen = 0
        CopyButton.Activated:Connect(function()
          CircleClick(CopyButton, Player:GetMouse().X, Player:GetMouse().Y)

          pcall(function()
            if setclipboard then setclipboard(Code) end
          end)

          ClickGen += 1
          local ThisGen = ClickGen

          CopyLabel.Text = "Copied"
          TweenService:Create(CopyBackStroke, TweenInfo.new(0.12), {Transparency = 1}):Play()
          TweenService:Create(CopyFrontStroke, TweenInfo.new(0.12), {Transparency = 1}):Play()

          task.delay(0.15, function()
            if ThisGen == ClickGen then
              TweenService:Create(CopyBackStroke, TweenInfo.new(0.12), {Transparency = 0}):Play()
              TweenService:Create(CopyFrontStroke, TweenInfo.new(0.12), {Transparency = 0}):Play()
