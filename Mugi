function MugiHub_Library:SetNotification(Config)
	if type(Config) == "string" then Config = { Content = Config } end
	Config = Config or {}
	EnsureNotifGui()
	local Text = tostring(Config.Content or Config[1] or "")
	local Head = Config.Title
	local Delay = tonumber(Config.Delay or Config[6]) or 3
	local AnimT = tonumber(Config.Time or Config[5]) or 0.25
	NotifCounter = NotifCounter + 1
	local Closed, BarTween = false, nil
	local NF = {}

	local TSz = TextService:GetTextSize(Text, 12, Enum.Font.GothamBold, Vector2.new(NOTIF_WIDTH - 36, 1000))
	local TextY = Head and 26 or 10
	local CardH = math.max(TextY + TSz.Y + 16, 38)

	local Slot = Custom:Create("Frame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true,
		LayoutOrder = NotifCounter, Size = UDim2.new(1, 0, 0, CardH), Name = "NotifSlot",
	}, NotifContainer)

	local Card = Custom:Create("Frame", {
		BackgroundColor3 = Color3.fromRGB(20, 14, 21), BackgroundTransparency = 0.04, BorderSizePixel = 0,
		Position = UDim2.new(1, NOTIF_WIDTH + 20, 0, 0), Size = UDim2.new(1, 0, 1, 0), Name = "Card",
		ClipsDescendants = true,
	}, Slot)
	Custom:Corner(Card, 10)
	local CardStroke = Custom:Stroke(Card, Theme.White, 0.35, 1.2)
	Custom:AddGradient(CardStroke, 0, Custom.GradientBorder)

	local Accent = Custom:Create("Frame", {
		BackgroundColor3 = Theme.White, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(0, 3, 1, 0), Name = "Accent",
	}, Card)
	Custom:AddGradient(Accent, 90)

	if Head then
		Custom:Label(Card, {
			Text = tostring(Head), TextColor3 = Theme.Soft, TextSize = 12,
			Position = UDim2.new(0, 16, 0, 8), Size = UDim2.new(1, -28, 0, 14), Name = "Title",
		})
	end
	Custom:Label(Card, {
		Text = Text, TextColor3 = Theme.Text, TextSize = 12, TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.new(0, 16, 0, TextY), Size = UDim2.new(1, -28, 0, TSz.Y + 2), Name = "Label",
	})

	local BarTrack = Custom:Create("Frame", {
		AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = Theme.White, BackgroundTransparency = 0.92,
		BorderSizePixel = 0, Position = UDim2.new(0, 14, 1, -5), Size = UDim2.new(1, -24, 0, 2), Name = "BarTrack",
	}, Card)
	Custom:Round(BarTrack)
	local Bar = Custom:Create("Frame", {
		BackgroundColor3 = Theme.White, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Name = "Bar",
	}, BarTrack)
	Custom:Round(Bar)
	Custom:AddGradient(Bar, 0)

	Custom:Tween(Card, AnimT, { Position = UDim2.new(0, 0, 0, 0) })

	task.spawn(function()
		BarTween = TweenService:Create(Bar, TweenInfo.new(Delay, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) })
		BarTween:Play()
		BarTween.Completed:Connect(function(State)
			if State == Enum.PlaybackState.Completed and not Closed then NF:Close() end
		end)
	end)

	local function DoClose()
		if Closed then return end
		Closed = true
		if BarTween then pcall(function() BarTween:Cancel() end) end
		local Out = Custom:Tween(Card, AnimT, { Position = UDim2.new(1, NOTIF_WIDTH + 20, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Out.Completed:Wait()
		if Slot and Slot.Parent then
			local Collapse = Custom:Tween(Slot, 0.15, { Size = UDim2.new(1, 0, 0, 0) })
			Collapse.Completed:Wait()
			if Slot and Slot.Parent then Slot:Destroy() end
		end
	end

	function NF:Close() task.spawn(DoClose) end
	return NF
end

function MugiHub_Library:CreateWindow(Config)
	local Title = Config[1] or Config.Title or ""
	local Desc = Config[2] or Config.Description or ""
	local TabWidth = Config[3] or Config["Tab Width"] or 105
	local SizeUi = Config[4] or Config.SizeUi or UDim2.fromOffset(480, 275)
	local Keybind = Config[5] or Config.Keybind or Enum.KeyCode.RightControl
	local Icon = Config[6] or Config.Icon or "rbxassetid://18505728250"
	local Funcs = {}
	local SearchRegistry = {}
	local Conns, Loops = {}, {}
	local Destroyed = false
	local Opened = true

	local function Track(c) table.insert(Conns, c) return c end
	local function Loop(inst, props, time, reverses, style)
		local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, reverses or false, 0), props)
		tw:Play()
		table.insert(Loops, tw)
