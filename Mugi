end

function MugiHub_Library:SetNotification(Config)
  EnsureNotificationGui()

  local Title = Config[1] or Config.Title or ""
  local Description = Config[2] or Config.Description or ""
	local Content = Config[3] or Config.Content or ""
  local Time = Config[5] or Config.Time or 0.35
  local Delay = tonumber(Config[6] or Config.Delay or 5)

  NotificationOrderCounter += 1

  local NotifFuncs = {}
  local Closed = false
  local BarTween = nil

  -- Slot dikelola UIListLayout (posisi/urutan otomatis, aman dari spam)
  local NotificationFrame = Custom:Create("Frame", {
    BackgroundTransparency = 1,
    BorderSizePixel = 0,
    LayoutOrder = NotificationOrderCounter,
    Size = UDim2.new(1, 0, 0, 54),
    Name = "NotificationFrame"
  }, NotificationLayout)

  -- Kartu asli (dianimasikan terpisah dari slot agar tidak bentrok dgn UIListLayout)
  local Card = Custom:Create("Frame", {
    BackgroundColor3 = Color3.fromRGB(18, 18, 18),
    BackgroundTransparency = 0.05,
    BorderSizePixel = 0,
    ClipsDescendants = true,
    Position = UDim2.new(0, 260, 0, 0),
    Size = UDim2.new(1, 0, 1, 0),
    Name = "Card"
  }, NotificationFrame)

  Custom:Create("UICorner", {
    CornerRadius = UDim.new(0, 6)
  }, Card)

  Custom:AddGradient(Custom:Create("UIStroke", {
    Color = Custom.ColorRGB,
    Thickness = 1,
    Transparency = 0.5
  }, Card))

  local TitleLabel = Custom:Create("TextLabel", {
    Font = Enum.Font.GothamBold,
    Text = Title,
    TextColor3 = Color3.fromRGB(240, 240, 240),
    TextSize = 12,
    TextXAlignment = Enum.TextXAlignment.Left,
    BackgroundTransparency = 1,
    Position = UDim2.new(0, 10, 0, 8),
    Size = UDim2.new(0, 120, 0, 14),
    Name = "TitleLabel"
  }, Card)

  local DescLabel = Custom:Create("TextLabel", {
    Font = Enum.Font.GothamBold,
    Text = Description,
    TextColor3 = Custom.ColorRGB,
    TextSize = 12,
    TextXAlignment = Enum.TextXAlignment.Left,
    BackgroundTransparency = 1,
    Position = UDim2.new(0, TitleLabel.TextBounds.X + 18, 0, 8),
    Size = UDim2.new(1, -(TitleLabel.TextBounds.X + 46), 0, 14),
    Name = "DescLabel"
  }, Card)

  local CloseButton = Custom:Create("TextButton", {
    Font = Enum.Font.GothamBold,
    Text = "×",
    TextColor3 = Color3.fromRGB(200, 200, 200),
    TextSize = 16,
    AnchorPoint = Vector2.new(1, 0),
    BackgroundTransparency = 1,
    BorderSizePixel = 0,
    Position = UDim2.new(1, -4, 0, 2),
    Size = UDim2.new(0, 22, 0, 22),
    Name = "CloseButton"
  }, Card)

  local ContentLabel = Custom:Create("TextLabel", {
    Font = Enum.Font.Gotham,
    Text = Content,
    TextColor3 = Color3.fromRGB(165, 165, 165),
    TextSize = 11,
    TextWrapped = false,
    TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Top,
    BackgroundTransparency = 1,
    Position = UDim2.new(0, 10, 0, 26),
    Size = UDim2.new(1, -20, 0, 13),
    Name = "ContentLabel"
  }, Card)

  local LineCount = (Content ~= "" and math.max(math.ceil(ContentLabel.TextBounds.X / ContentLabel.AbsoluteSize.X), 1)) or 0
  ContentLabel.Size = UDim2.new(1, -20, 0, 13 * LineCount)
  ContentLabel.TextWrapped = true

  local CardHeight = (Content ~= "" and (26 + (13 * LineCount) + 12)) or 34
  NotificationFrame.Size = UDim2.new(1, 0, 0, CardHeight)

  -- Bar countdown (menipis dari kiri ke kanan selama durasi Delay)
  local Bar = Custom:Create("Frame", {
    AnchorPoint = Vector2.new(0, 1),
    BackgroundColor3 = Custom.ColorRGB,
    BorderSizePixel = 0,
    Position = UDim2.new(0, 0, 1, 0),
    Size = UDim2.new(1, 0, 0, 3),
    Name = "Bar"
  }, Card)
  Custom:AddGradient(Bar)

  local function CloseNotification()
    if Closed then return end
    Closed = true

    if BarTween then pcall(function() BarTween:Cancel() end) end

    local OutTween = TweenService:Create(Card, TweenInfo.new(Time, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
      Position = UDim2.new(0, 260, 0, 0)
    })
    OutTween:Play()
    OutTween.Completed:Wait()

    if NotificationFrame and NotificationFrame.Parent then
      NotificationFrame:Destroy()
    end
  end

  function NotifFuncs:Close()
    task.spawn(CloseNotification)
  end

  CloseButton.Activated:Connect(function()
    NotifFuncs:Close()
  end)

  -- Slide-in + mulai hitung mundur (semua non-blocking, aman dipanggil berkali-kali/spam)
  TweenService:Create(Card, TweenInfo.new(Time, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Position = UDim2.new(0, 0, 0, 0)
  }):Play()

  task.spawn(function()
    BarTween = TweenService:Create(Bar, TweenInfo.new(Delay, Enum.EasingStyle.Linear), {
      Size = UDim2.new(0, 0, 0, 3)
    })
    BarTween:Play()
    BarTween.Completed:Connect(function(PlaybackState)
      if PlaybackState == Enum.PlaybackState.Completed and not Closed then
        task.spawn(CloseNotification)
      end
    end)
  end)

  return NotifFuncs
end

